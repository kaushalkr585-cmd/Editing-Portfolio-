# Server Port
PORT=5000
NODE_ENV=development

# JWT Secret for Admin Authentication
JWT_SECRET=supersecret_jwt_key_change_in_production_min_32_chars

# MongoDB Atlas Connection URI (Falls back to in-memory/seed demo mode if empty)
MONGODB_URI=

# Cloudinary Integration (Required for uploading new videos/images; falls back to demo mode)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NVIDIA Nemotron AI Integration (Falls back to intelligent local creative assistant if empty)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct

# Admin Default Setup (used only if no admin exists during initial setup)
DEFAULT_ADMIN_EMAIL=admin@kaushalkumar.com
DEFAULT_ADMIN_PASSWORD=
