# ==========================================
# KAUSHAL KUMAR VIDEO EDITING PORTFOLIO (.env)
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# Admin Authentication
JWT_SECRET=supersecret_jwt_key_change_in_production_min_32_chars

# MongoDB Atlas Database URI (Optional in dev: seamlessly falls back to in-memory store)
MONGODB_URI=

# Cloudinary Integration (For video delivery, auto-transcoding & posters)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NVIDIA Nemotron AI Integration (Falls back to intelligent local creative engine if empty)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-4-340b-instruct
